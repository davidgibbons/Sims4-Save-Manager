{
  "name": "sims4-save-manager",
  "version": "3.2.0",
  "description": "Back up and safely restore The Sims 4 saves",
  "author": "Sims 4 Save Manager contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/davidgibbons/Sims4-Save-Manager.git"
  },
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "pack": "electron-builder --dir --publish never",
    "dist": "electron-builder --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --publish never"
  },
  "dependencies": {
    "@s4tk/compression": "0.2.0",
    "electron-updater": "6.8.11"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.sims4savemanager.desktop",
    "productName": "Sims 4 Save Manager",
    "artifactName": "Sims4-Save-Manager-${version}-${os}-${arch}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "davidgibbons",
        "repo": "Sims4-Save-Manager"
      }
    ],
    "asar": true,
    "files": [
      "src/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "win": {
      "icon": "src/assets/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "Sims4-Save-Manager-Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "icon": "src/assets/icon.png"
  }
}
